---
interface Props {
  title: string;
  description: string;
  date: Date;
  author?: string;
}

const { title, description, date, author } = Astro.props;
const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Banyan</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5b8c2a" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Banyan" />
    <meta property="og:image" content="https://getbanyan.dev/og-image.png" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href="/og-image.png" />
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">
        <img src="/og-image.png" alt="Banyan" width="28" height="28" />
        <span>Banyan</span>
      </a>
      <div class="nav-links">
        <a href="/blog/">Blog</a>
        <a href="/getting-started/quickstart/">Docs</a>
        <a href="https://github.com/fertile-org/banyan">GitHub</a>
      </div>
    </nav>

    <main>
      <article>
        <header>
          <time datetime={date.toISOString().slice(0, 10)}>{formattedDate}</time>
          {author && <span class="author">by {author}</span>}
          <h1>{title}</h1>
          <p class="description">{description}</p>
        </header>
        <div class="prose">
          <slot />
        </div>
      </article>
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Banyan. Open source under Apache 2.0.</p>
    </footer>
  </body>
</html>

<style>
  /* Reset */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --green: #5b8c2a;
    --green-dark: #3d6b1a;
    --bg: #1a1816;
    --bg-surface: #272420;
    --text: #ede9e3;
    --text-muted: #8a8478;
    --text-dim: #5c574e;
    --border: #3a3630;
    --bg-code: #1a1714;
    --max-width: 900px;
    color-scheme: dark;
  }

  @media (prefers-color-scheme: light) {
    :root {
      --green: #3d6b1a;
      --green-dark: #2d5010;
      --bg: #faf8f5;
      --bg-surface: #f5f2ee;
      --text: #1a1816;
      --text-muted: #5c574e;
      --text-dim: #8a8478;
      --border: #ede9e3;
      --bg-code: #e8e4de;
    }
  }

  html {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    line-height: 1.7;
    color: var(--text);
    background: var(--bg);
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image: url("/page-background.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.15;
    z-index: -1;
  }

  /* Nav */
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .nav-logo img {
    border-radius: 4px;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.15s;
  }

  .nav-links a:hover {
    color: var(--green);
  }

  /* Article */
  main {
    flex: 1;
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }

  header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  header time {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  header .author {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-left: 0.5rem;
  }

  header h1 {
    margin-top: 0.75rem;
    font-size: 2.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  header .description {
    margin-top: 0.75rem;
    font-size: 1.125rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Prose */
  .prose :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .prose :global(h3) {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--text);
  }

  .prose :global(h4) {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
    color: var(--text);
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
    color: var(--text);
  }

  .prose :global(a) {
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(a:hover) {
    color: var(--green-dark);
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(em) {
    font-style: italic;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    border-left: 3px solid var(--green);
    color: var(--text-muted);
    background: var(--bg-surface);
    border-radius: 0 6px 6px 0;
  }

  .prose :global(code) {
    font-family: "SF Mono", "Fira Code", "Fira Mono", Menlo, Consolas, monospace;
    font-size: 0.875em;
    background: var(--bg-surface);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    color: var(--text);
  }

  .prose :global(pre) {
    margin: 1.5rem 0;
    padding: 1.25rem;
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow-x: auto;
    line-height: 1.5;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.85rem;
  }

  .prose :global(hr) {
    margin: 3rem 0;
    border: none;
    border-top: 1px solid var(--border);
  }

  .prose :global(table) {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .prose :global(th) {
    text-align: left;
    padding: 0.75rem;
    border-bottom: 2px solid var(--border);
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(td) {
    padding: 0.75rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  /* Footer */
  footer {
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--border);
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  /* Mobile */
  @media (max-width: 640px) {
    header h1 {
      font-size: 1.75rem;
    }

    header .description {
      font-size: 1rem;
    }

    .prose :global(h2) {
      font-size: 1.3rem;
    }

    .prose :global(h3) {
      font-size: 1.1rem;
    }
  }
</style>
